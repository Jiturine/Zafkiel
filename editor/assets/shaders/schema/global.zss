#parameters
ViewPosition = uGlobal.viewPos;
ViewMatrix = uGlobal.viewMatrix;
ProjectionMatrix = uGlobal.projectionMatrix;
ViewProjectionMatrix = uGlobal.viewProjectionMatrix;

#version 450

layout(std140, set = 0, binding = 0) uniform GlobalUBO {
    vec3 viewPos;
    mat4 viewMatrix;
    mat4 projectionMatrix;
    mat4 viewProjectionMatrix;
} uGlobal;